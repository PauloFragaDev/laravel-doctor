{
    "name": "laravel-doctor/laravel-doctor",
    "description": "Auditor determinista para codebases Laravel: seguridad, performance, Eloquent y arquitectura.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "linter", "static-analysis", "security", "performance", "eloquent", "blade", "code-quality", "audit"],
    "require": {
        "php": ">=8.2",
        "nikic/php-parser": "^5.0",
        "php-tui/php-tui": "^0.2.1",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "LaravelDoctor\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "LaravelDoctor\\Tests\\": "tests/" }
    },
    "bin": ["bin/laravel-doctor"],
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelDoctor\\Laravel\\LaravelDoctorServiceProvider"
            ]
        }
    }
}
